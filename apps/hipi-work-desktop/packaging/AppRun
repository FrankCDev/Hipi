#!/bin/sh
set -eu
# Resolve our own AppDir; never trust an inherited APPDIR to select executable code.
SELF=$(readlink -f -- "$0")
test -f "$SELF"
APPDIR=$(CDPATH= cd -- "$(dirname -- "$SELF")" && pwd -P)
export APPDIR
for argument do
  case "$argument" in
    --no-sandbox|--no-sandbox=*|-no-sandbox|-no-sandbox=*|--disable-*sandbox*|-disable-*sandbox*|--single-process|--single-process=*|-single-process|-single-process=*|--in-process-gpu|--in-process-gpu=*|-in-process-gpu|-in-process-gpu=*)
      echo 'Hipi Work refuses sandbox-disabling launch arguments.' >&2
      exit 64
      ;;
  esac
done
export PATH="$APPDIR:$APPDIR/usr/sbin${PATH:+:$PATH}"
export XDG_DATA_DIRS="$APPDIR/usr/share${XDG_DATA_DIRS:+:$XDG_DATA_DIRS}:/usr/share/gnome:/usr/local/share:/usr/share"
export LD_LIBRARY_PATH="$APPDIR/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export GSETTINGS_SCHEMA_DIR="$APPDIR/usr/share/glib-2.0/schemas${GSETTINGS_SCHEMA_DIR:+:$GSETTINGS_SCHEMA_DIR}"
# Electron must fail normally if the host cannot provide its sandbox. No retry.
exec "$APPDIR/hipi-work" "$@"
