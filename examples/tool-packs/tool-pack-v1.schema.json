{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Hipi Work declarative tool pack v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "id",
    "version",
    "name",
    "description",
    "tools"
  ],
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(?!hipi(?:\\.|-)|hipi$)[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$(?![\\s\\S])"
    },
    "version": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$(?![\\s\\S])"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[^\\uD800-\\uDFFF]*$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\uD800-\\uDFFF]*$"
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "description",
          "pipeline"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,23}$(?![\\s\\S])"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[^\\uD800-\\uDFFF]*$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[^\\uD800-\\uDFFF]*$"
          },
          "pipeline": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "op"
                  ],
                  "properties": {
                    "op": {
                      "enum": [
                        "normalizeNewlines",
                        "trimLineEnds",
                        "removeEmptyLines",
                        "deduplicateLines"
                      ]
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "op",
                    "search",
                    "replacement"
                  ],
                  "properties": {
                    "op": {
                      "const": "literalReplace"
                    },
                    "search": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1024,
                      "pattern": "^[^\\uD800-\\uDFFF]*$"
                    },
                    "replacement": {
                      "type": "string",
                      "minLength": 0,
                      "maxLength": 1024,
                      "pattern": "^[^\\uD800-\\uDFFF]*$"
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
